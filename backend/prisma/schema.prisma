generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DONOR
  HOSPITAL_STAFF
  DOCTOR
  ADMIN
  USER
}

enum AccountType {
  INDIVIDUAL
  HOSPITAL
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DonorAvailability {
  AVAILABLE
  UNAVAILABLE
}

enum ReportType {
  IMAGE
  PDF
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  ADDITIONAL_INFO_REQUIRED
}

enum HospitalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum HospitalStaffRole {
  OWNER
  ADMIN
  MANAGER
  TECHNICIAN
  VIEWER
}

enum ScreeningStatus {
  PENDING
  PASSED
  FAILED
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum BloodUnitStatus {
  AVAILABLE
  RESERVED
  USED
  DISCARDED
}

enum BloodComponent {
  WHOLE_BLOOD
  RED_CELLS
  PLASMA
  PLATELETS
  CRYOPRECIPITATE
}

enum RequestUrgency {
  ROUTINE
  URGENT
  EMERGENCY
}

enum BloodRequestStatus {
  OPEN
  FULFILLED
  CANCELLED
}

model User {
  id              Int         @id @default(autoincrement())
  email           String      @unique
  passwordHash    String
  passwordVersion Int         @default(0)
  name            String
  accountType     AccountType
  role            UserRole    @default(USER)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  donorProfile       DonorProfile?
  hospitalProfile    HospitalProfile?
  hospitalStaffMember HospitalStaffMember?
  medicalReports     MedicalReport[]
  passwordResetToken PasswordResetToken?
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RevokedToken {
  id        Int      @id @default(autoincrement())
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model RateLimitCounter {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model DonorProfile {
  id                   Int                @id @default(autoincrement())
  userId               Int                @unique
  faydaId              String?
  dateOfBirth          DateTime?
  phone                String
  additionalPhone      String?
  address              String
  age                  Int
  weight               Float
  height               Float
  bloodType            BloodType?
  currentAvailability  DonorAvailability  @default(UNAVAILABLE)
  lastDonation         DateTime?
  donationIntervalDays Int                @default(90)
  verificationStatus   VerificationStatus @default(PENDING)
  verificationNotes    String?
  verifiedAt           DateTime?
  consentToContact     Boolean            @default(false)
  shareLocation        Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  availabilities  DonorAvailabilitySchedule[]
  medicalReports  MedicalReport[]
  donationHistory DonationRecord[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DonorAvailabilitySchedule {
  id             Int       @id @default(autoincrement())
  donorProfileId Int
  day            DayOfWeek
  time           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  donorProfile DonorProfile @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)

  @@unique([donorProfileId, day])
}

model HospitalProfile {
  id              Int            @id @default(autoincrement())
  userId          Int            @unique
  hospitalName    String
  address         String
  phone           String
  additionalPhone String?
  isVerified      Boolean        @default(false)
  status          HospitalStatus @default(PENDING)
  reviewNotes     String?
  reviewedAt      DateTime?
  reviewedByUserId Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  staff      HospitalStaffMember[]
  bloodUnits BloodUnit[]
  bloodRequests BloodRequest[]
}

model HospitalStaffMember {
  id                Int               @id @default(autoincrement())
  hospitalProfileId Int
  userId            Int               @unique
  staffRole         HospitalStaffRole @default(VIEWER)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  hospitalProfile HospitalProfile @relation(fields: [hospitalProfileId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hospitalProfileId])
}

model BloodUnit {
  id                 Int                @id @default(autoincrement())
  hospitalProfileId  Int
  bagId              String
  bloodType          BloodType
  component          BloodComponent     @default(RED_CELLS)
  collectionDate     DateTime
  expiryDate         DateTime
  screeningStatus    ScreeningStatus    @default(PENDING)
  confirmationStatus ConfirmationStatus @default(PENDING)
  status             BloodUnitStatus    @default(AVAILABLE)
  storageLocation    String?
  storageNotes       String?
  screenedAt         DateTime?
  confirmedAt        DateTime?
  createdByUserId    Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  hospitalProfile HospitalProfile @relation(fields: [hospitalProfileId], references: [id], onDelete: Cascade)

  @@unique([hospitalProfileId, bagId])
  @@index([hospitalProfileId])
  @@index([hospitalProfileId, bloodType])
  @@index([expiryDate])
}

model BloodRequest {
  id                Int                @id @default(autoincrement())
  hospitalProfileId Int
  createdByUserId   Int
  component         BloodComponent
  bloodType         BloodType
  requiredUnits     Int
  urgency           RequestUrgency     @default(ROUTINE)
  location          String?
  notes             String?
  status            BloodRequestStatus @default(OPEN)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  hospitalProfile HospitalProfile @relation(fields: [hospitalProfileId], references: [id], onDelete: Cascade)

  @@index([hospitalProfileId])
  @@index([status])
  @@index([bloodType, component])
}

model MedicalReport {
  id                 Int                @id @default(autoincrement())
  donorProfileId     Int
  uploadedByUserId   Int
  reportType         ReportType
  fileUrl            String
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  donorProfile DonorProfile @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
}

model DonationRecord {
  id             Int      @id @default(autoincrement())
  donorProfileId Int
  donatedAt      DateTime
  facilityName   String?
  units          Float?
  notes          String?
  createdAt      DateTime @default(now())

  donorProfile DonorProfile @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)

  @@index([donorProfileId])
}
