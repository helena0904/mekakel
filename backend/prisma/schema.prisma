generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DONOR
  HOSPITAL_STAFF
  DOCTOR
  ADMIN
  USER
}

enum AccountType {
  INDIVIDUAL
  HOSPITAL
}

model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  passwordHash String
  name         String
  accountType  AccountType
  role         UserRole    @default(USER)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}
