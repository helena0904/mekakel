generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DONOR
  HOSPITAL_STAFF
  DOCTOR
  ADMIN
  USER
}

enum AccountType {
  INDIVIDUAL
  HOSPITAL
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DonorAvailability {
  AVAILABLE
  UNAVAILABLE
}

enum DonorActiveStatus {
  ACTIVE
  INACTIVE
}

enum ReportType {
  IMAGE
  PDF
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  ADDITIONAL_INFO_REQUIRED
}

enum HospitalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum HospitalStaffRole {
  OWNER
  ADMIN
  MANAGER
  TECHNICIAN
  VIEWER
}

enum ScreeningStatus {
  NOT_TESTED
  PENDING
  PASSED
  FAILED
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum BloodUnitStatus {
  PENDING
  AVAILABLE
  RESERVED
  TRANSFERRED
  USED
  EXPIRED
  DISCARDED
}

enum BloodComponent {
  WHOLE_BLOOD
  RED_CELLS
  PLASMA
  PLATELETS
  CRYOPRECIPITATE
}

enum RequestUrgency {
  ROUTINE
  URGENT
  EMERGENCY
}

enum BloodRequestStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  CONFIRMED
  CANCELLED
  EXPIRED
  RELEASED
  CONSUMED
}

enum DonorResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
  NO_SHOW
}

enum ReservationKind {
  BLOOD_UNIT
  DONOR
}

enum TransferStatus {
  REQUESTED
  APPROVED
  DISPATCHED
  RECEIVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum NotificationCategory {
  DONOR
  HOSPITAL
  RESERVATION
  TRANSFER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

enum NotificationType {
  DONOR_REGISTERED
  DONOR_VERIFICATION_APPROVED
  DONOR_VERIFICATION_REJECTED
  DONOR_ADDITIONAL_INFO_REQUIRED
  DONOR_BLOOD_REQUESTED
  HOSPITAL_REGISTERED
  HOSPITAL_APPROVED
  HOSPITAL_REJECTED
  HOSPITAL_SUSPENDED
  HOSPITAL_ACTIVATED
  RESERVATION_CONFIRMED
  RESERVATION_CANCELLED
  RESERVATION_RELEASED
  RESERVATION_EXPIRED
  RESERVATION_CONSUMED
  TRANSFER_REQUESTED
  TRANSFER_APPROVED
  TRANSFER_REJECTED
  TRANSFER_DISPATCHED
  TRANSFER_RECEIVED
  TRANSFER_COMPLETED
  TRANSFER_CANCELLED
}

enum AuditAction {
  DONOR_VERIFICATION_DECIDED
  HOSPITAL_REGISTRATION_DECIDED
  USER_ROLE_CHANGED
  USER_STATUS_CHANGED
  SETTINGS_UPDATED
  INVENTORY_UNIT_CREATED
  INVENTORY_UNIT_UPDATED
  INVENTORY_UNIT_DELETED
  RESERVATION_CREATED
  RESERVATION_CONFIRMED
  RESERVATION_CANCELLED
  RESERVATION_RELEASED
  RESERVATION_CONSUMED
  RESERVATION_EXPIRED
  DONOR_RESPONSE_RECORDED
  MEDICAL_REPORT_ACCESSED
  DONOR_BLOOD_REQUESTED
  CONSENT_CHANGED
  EMERGENCY_OVERRIDE_USED
  TRANSFER_REQUESTED
  TRANSFER_APPROVED
  TRANSFER_REJECTED
  TRANSFER_DISPATCHED
  TRANSFER_RECEIVED
  TRANSFER_COMPLETED
  TRANSFER_CANCELLED
}

model User {
  id              Int         @id @default(autoincrement())
  email           String      @unique
  passwordHash    String
  passwordVersion Int         @default(0)
  name            String
  accountType     AccountType
  role            UserRole    @default(USER)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  donorProfile        DonorProfile?
  hospitalProfile     HospitalProfile?
  hospitalStaffMember HospitalStaffMember?
  medicalReports      MedicalReport[]
  passwordResetToken  PasswordResetToken?

  notifications          Notification[]
  notificationPreference NotificationPreference?
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RevokedToken {
  id        Int      @id @default(autoincrement())
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model RateLimitCounter {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model DonorProfile {
  id                   Int                @id @default(autoincrement())
  userId               Int                @unique
  faydaId              String?            @unique
  dateOfBirth          DateTime?
  phone                String
  additionalPhone      String?
  address              String
  subcity              String?
  wereda               String?
  age                  Int
  weight               Float
  height               Float
  bloodType            BloodType?
  currentAvailability  DonorAvailability  @default(UNAVAILABLE)
  lastDonation         DateTime?
  donationIntervalDays Int                @default(90)
  verificationStatus   VerificationStatus @default(PENDING)
  verificationNotes    String?
  verifiedAt           DateTime?
  activeStatus         DonorActiveStatus  @default(INACTIVE)
  activationNotes      String?
  consentToContact     Boolean            @default(false)
  shareLocation        Boolean            @default(false)
  matchingOptOut       Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  availabilities  DonorAvailabilitySchedule[]
  medicalReports  MedicalReport[]
  donationHistory DonationRecord[]
  reservations    Reservation[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DonorAvailabilitySchedule {
  id             Int       @id @default(autoincrement())
  donorProfileId Int
  day            DayOfWeek
  time           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  donorProfile DonorProfile @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)

  @@unique([donorProfileId, day])
}

model HospitalProfile {
  id               Int            @id @default(autoincrement())
  userId           Int            @unique
  hospitalName     String
  address          String
  subcity          String?
  wereda           String?
  phone            String
  additionalPhone  String?
  isVerified       Boolean        @default(false)
  status           HospitalStatus @default(PENDING)
  reviewNotes      String?
  reviewedAt       DateTime?
  reviewedByUserId Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  staff         HospitalStaffMember[]
  bloodUnits    BloodUnit[]
  bloodRequests BloodRequest[]
  reservations  Reservation[]
  transfersFrom Transfer[]            @relation("TransferFromHospital")
  transfersTo   Transfer[]            @relation("TransferToHospital")
}

model HospitalStaffMember {
  id                Int               @id @default(autoincrement())
  hospitalProfileId Int
  userId            Int               @unique
  staffRole         HospitalStaffRole @default(VIEWER)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  hospitalProfile HospitalProfile @relation(fields: [hospitalProfileId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hospitalProfileId])
}

model BloodUnit {
  id                 Int                @id @default(autoincrement())
  hospitalProfileId  Int
  bagId              String
  bloodType          BloodType
  component          BloodComponent     @default(RED_CELLS)
  collectionDate     DateTime
  expiryDate         DateTime
  screeningStatus    ScreeningStatus    @default(PENDING)
  confirmationStatus ConfirmationStatus @default(PENDING)
  bloodTypeConfirmed Boolean            @default(false)
  status             BloodUnitStatus    @default(PENDING)
  storageLocation    String?
  storageNotes       String?
  screenedBy         Int?
  screenedAt         DateTime?
  confirmedAt        DateTime?
  createdByUserId    Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  hospitalProfile HospitalProfile @relation(fields: [hospitalProfileId], references: [id], onDelete: Cascade)

  reservations Reservation[]
  transfers    Transfer[]

  @@unique([hospitalProfileId, bagId])
  @@index([hospitalProfileId])
  @@index([hospitalProfileId, bloodType])
  @@index([expiryDate])
}

model BloodRequest {
  id                Int                @id @default(autoincrement())
  hospitalProfileId Int
  createdByUserId   Int
  component         BloodComponent
  bloodType         BloodType
  requiredUnits     Int
  urgency           RequestUrgency     @default(ROUTINE)
  location          String?
  notes             String?
  status            BloodRequestStatus @default(OPEN)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  hospitalProfile HospitalProfile @relation(fields: [hospitalProfileId], references: [id], onDelete: Cascade)

  reservations Reservation[]

  @@index([hospitalProfileId])
  @@index([status])
  @@index([bloodType, component])
}

model MedicalReport {
  id                 Int                @id @default(autoincrement())
  donorProfileId     Int
  uploadedByUserId   Int
  reportType         ReportType
  fileUrl            String
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  donorProfile DonorProfile @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
}

model DonationRecord {
  id             Int      @id @default(autoincrement())
  donorProfileId Int
  donatedAt      DateTime
  facilityName   String?
  units          Float?
  notes          String?
  createdAt      DateTime @default(now())

  donorProfile DonorProfile @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)

  @@index([donorProfileId])
}

model Reservation {
  id                Int                 @id @default(autoincrement())
  bloodUnitId       Int?
  bloodRequestId    Int?
  hospitalProfileId Int
  donorProfileId    Int?
  kind              ReservationKind     @default(BLOOD_UNIT)
  status            ReservationStatus   @default(ACTIVE)
  donorResponse     DonorResponseStatus @default(PENDING)
  donorRespondedAt  DateTime?
  expiresAt         DateTime
  notes             String?
  reason            String?
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  releasedAt        DateTime?
  consumedAt        DateTime?
  createdByUserId   Int
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  bloodUnit       BloodUnit?      @relation(fields: [bloodUnitId], references: [id], onDelete: Cascade)
  bloodRequest    BloodRequest?   @relation(fields: [bloodRequestId], references: [id], onDelete: SetNull)
  hospitalProfile HospitalProfile @relation(fields: [hospitalProfileId], references: [id], onDelete: Cascade)
  donorProfile    DonorProfile?   @relation(fields: [donorProfileId], references: [id], onDelete: SetNull)
  transfers       Transfer[]

  @@index([bloodUnitId])
  @@index([donorProfileId])
  @@index([hospitalProfileId])
  @@index([bloodRequestId])
  @@index([status])
  @@index([expiresAt])
}

model Transfer {
  id                    Int            @id @default(autoincrement())
  bloodUnitId           Int
  fromHospitalProfileId Int
  toHospitalProfileId   Int
  reservationId         Int?
  status                TransferStatus @default(REQUESTED)
  reason                String?
  notes                 String?
  rejectionReason       String?
  requestedByUserId     Int
  approvedByUserId      Int?
  dispatchedByUserId    Int?
  receivedByUserId      Int?
  completedByUserId     Int?
  approvedAt            DateTime?
  dispatchedAt          DateTime?
  receivedAt            DateTime?
  completedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  bloodUnit    BloodUnit       @relation(fields: [bloodUnitId], references: [id], onDelete: Cascade)
  fromHospital HospitalProfile @relation("TransferFromHospital", fields: [fromHospitalProfileId], references: [id], onDelete: Cascade)
  toHospital   HospitalProfile @relation("TransferToHospital", fields: [toHospitalProfileId], references: [id], onDelete: Cascade)
  reservation  Reservation?    @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  events       TransferEvent[]

  @@index([bloodUnitId])
  @@index([fromHospitalProfileId])
  @@index([toHospitalProfileId])
  @@index([reservationId])
  @@index([status])
}

model TransferEvent {
  id          Int             @id @default(autoincrement())
  transferId  Int
  fromStatus  TransferStatus?
  toStatus    TransferStatus
  note        String?
  actorUserId Int?
  createdAt   DateTime        @default(now())

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
}

model NotificationPreference {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  emailEnabled       Boolean  @default(true)
  donorUpdates       Boolean  @default(true)
  hospitalUpdates    Boolean  @default(true)
  reservationUpdates Boolean  @default(true)
  transferUpdates    Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id                Int                  @id @default(autoincrement())
  userId            Int
  recipientEmail    String
  type              NotificationType
  category          NotificationCategory
  subject           String
  body              String               @db.Text
  html              String?              @db.Text
  status            NotificationStatus   @default(PENDING)
  attempts          Int                  @default(0)
  maxAttempts       Int                  @default(3)
  lastError         String?              @db.Text
  dedupeKey         String?              @unique
  relatedEntityType String?
  relatedEntityId   Int?
  metadata          Json?
  scheduledAt       DateTime             @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, scheduledAt])
  @@index([userId, readAt])
}

model AuditLog {
  id            Int         @id @default(autoincrement())
  actorUserId   Int?
  actorName     String?
  actorRole     UserRole?
  action        AuditAction
  entityType    String
  entityId      Int?
  summary       String      @db.Text
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime    @default(now())

  @@index([action])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemSetting {
  id              Int      @id @default(autoincrement())
  key             String   @unique
  value           Json
  description     String?
  updatedByUserId Int?
  updatedByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
