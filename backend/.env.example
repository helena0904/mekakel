# ---------------------------------------------------------------------------
# MEKAKEL backend environment variables
# Copy to .env and fill in real values. Never commit the real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mekakel"

# Secret used to sign JWTs. Use a long, random value (e.g. openssl rand -hex 32).
JWT_SECRET="replace-with-a-long-random-secret"

# HTTP server port.
PORT=3000

# Number of trusted proxy hops in front of the server (for correct client IPs
# and rate limiting). Use false when the server is directly exposed.
TRUST_PROXY=false

# Allowed browser origins for CORS. CORS_ORIGINS is a comma-separated list and
# takes precedence; otherwise FRONTEND_URL is used.
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"

# SMTP settings for outgoing email (password reset and workflow
# notifications: donor verification, hospital review, reservations,
# transfers).
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="no-reply@example.com"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM="MEKAKEL <no-reply@example.com>"
