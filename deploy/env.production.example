# MEKAKEL production environment
#
# Copy this file to .env.production (same directory) and fill in real values.
# .env.production is ignored by git because it matches the root ".env.*" rule.
# Never commit real passwords, JWT secrets, SMTP credentials, or certificates.
#
#   cp env.production.example .env.production
#   chmod 600 .env.production
#
# Compose commands in the README use:
#   docker compose --env-file .env.production -f docker-compose.prod.yml ...
#
# NOTE: POSTGRES_PASSWORD is embedded in the backend DATABASE_URL. Use a long
# random value without URL-reserved characters (@ : / ? # [ ] %). If you must
# use them, URL-encode the password in POSTGRES_PASSWORD.

# Compose project/volume prefix. Change this only before the first deploy.
COMPOSE_PROJECT_NAME=mekakel-prod

# IMAGE_TAG lets you pin/roll back built images (use a git SHA or date).
IMAGE_TAG=latest

# Uncomment to enable the Caddy HTTPS profile. Leave empty/absent when using
# an external load balancer or reverse proxy on the same host.
COMPOSE_PROFILES=tls

# Required when COMPOSE_PROFILES=tls. DNS A/AAAA record must point to this
# server, and ports 80/443 must be reachable for certificate issuance.
DOMAIN=mekakel.example.com
ACME_EMAIL=admin@example.com

# Public origin used for CORS. Must match the browser-facing URL exactly.
PUBLIC_URL=https://mekakel.example.com
# Optional comma-separated override. Leave empty to use PUBLIC_URL.
CORS_ORIGINS=

# Loopback port for the frontend when Caddy is disabled. It is bound to
# 127.0.0.1 only, so do not open it in the firewall.
HTTP_PORT=8080

# Number of trusted proxy hops. Keep 1 while Caddy/your proxy is the only
# ingress and the backend has no published port.
TRUST_PROXY=1

# PostgreSQL container settings.
POSTGRES_USER=mekakel
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=mekakel

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Outgoing email (required for password resets and workflow notifications).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="MEKAKEL <no-reply@example.com>"

# Backups. Prefer a path on a different disk/volume than Docker's data.
# The directory is created with mode 700 by backup.sh.
BACKUP_DIR=/var/backups/mekakel
# Optional: encrypt backups with age. Requires the age binary on the host.
# Example: age1...
AGE_RECIPIENT=
# Optional: delete backup directories older than N days (0 = keep forever).
RETENTION_DAYS=14
